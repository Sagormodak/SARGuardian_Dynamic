# development or production; production requires explicit CORS_ORIGINS.
APP_ENV=development

# Firebase Admin uses Application Default Credentials or this server-side file path.
# Never put this file's real value in frontend VITE_* variables.
# Example placeholder only; keep the real credential file outside the repository.
GOOGLE_APPLICATION_CREDENTIALS=path/to/server-side-firebase-admin-credentials.json
# Vercel only: set the full service-account JSON as a hosting secret instead of the path above.
# Do not put a real credential value in this file or in any frontend variable.
# FIREBASE_SERVICE_ACCOUNT_JSON=replace-with-hosting-provided-service-account-json

# Optional; defaults to localhost development origins.
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Hosting platforms provide this; local development defaults to 8000.
PORT=8000

# Read-only ASF metadata search is enabled by default; set false to disable it.
ASF_CATALOG_ENABLED=true
ASF_SEARCH_URL=https://api.daac.asf.alaska.edu/services/search/param
ASF_MAX_RESULTS=2000
ASF_TIMEOUT_SECONDS=20

# Server-only Supabase persistence. Never expose the key to Frontend/.
SUPABASE_URL=https://your-staging-project.supabase.co
# Keep this variable name for the server-only key. It may contain a modern
# sb_secret_... key or a legacy service_role JWT key.
SUPABASE_SERVICE_ROLE_KEY=sb_secret_replace_with_server_only_value
PREFLIGHT_TTL_SECONDS=86400
