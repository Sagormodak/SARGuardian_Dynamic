# Public browser configuration only. Never put Supabase server keys, Firebase Admin JSON,
# Earthdata credentials, or other server secrets in a VITE_* variable.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_APP_ID=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_MEASUREMENT_ID=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_GOOGLE_MAPS_API_KEY=
# Metadata-only ASF catalogue preflight API; set the deployed backend's public URL on Vercel.
VITE_SARGUARDIAN_API_URL=http://localhost:8000
